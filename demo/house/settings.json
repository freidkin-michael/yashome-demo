  "Hallway motion": {
   "occupancy": {
    "true": {
     "target": "Hallway light",
     "code": "state",
     "action": "on",
     "for": 120,
     "retrigger": "extend",
     "conditions": [
      {
       "device": "Hallway motion",
       "code": "illuminance",
       "op": "<",
       "value": 80
      }
     ]
    }
   }
  },
  "Kitchen motion": {
   "occupancy": {
    "true": {
     "target": "Under-cabinet lights",
     "code": "state",
     "action": "on",
     "for": 300,
     "retrigger": "extend",
     "time_window": {
      "from": "18:00",
      "to": "07:00",
      "days": [
       1,
       2,
       3,
       4,
       5,
       6,
       7
      ]
     }
    }
   }
  },
  "Bathroom climate": {
   "humidity": {
    "above": {
     "target": "bath_fan",
     "code": "power",
     "action": "on",
     "threshold": 70,
     "hyst": 5
    },
    "below": {
     "target": "bath_fan",
     "code": "power",
     "action": "off",
     "threshold": 58,
     "hyst": 3
    }
   }
  },
  "Living room window": {
   "contact": {
    "false": {
     "target": "living_ac",
     "code": "power",
     "action": "off"
    }
   }
  },
  "Bedroom window": {
   "contact": {
    "false": {
     "target": "bedroom_ac",
     "code": "power",
     "action": "off"
    }
   }
  },
  "Sofa button": {
   "action": {
    "single": {
     "target": "Living room ceiling",
     "code": "state",
     "action": "toggle"
    },
    "double": {
     "target": "Living room wall switch",
     "code": "state_l2",
     "action": "toggle"
    },
    "hold": {
     "target": "Living room wall switch",
     "code": "state_l1",
     "action": "toggle"
    }
   }
  },
  "Bedside button": {
   "action": {
    "single": {
     "target": "Bedside lamp",
     "code": "state",
     "action": "toggle"
    },
    "double": {
     "target": "Bedroom ceiling",
     "code": "state",
     "action": "off"
    }
   }
  },
  "Doorbell": {
   "action": {
    "single": {
     "target": "Hallway light",
     "code": "state",
     "action": "on",
     "for": 60,
     "retrigger": "restart"
    }
   }
  },
  "Kitchen leak": {
   "water_leak": {
    "true": {
     "target": "water_heater",
     "code": "power",
     "action": "off"
    }
   }
  },
  "Kitchen smoke": {
   "smoke": {
    "true": {
     "target": "Kitchen light",
     "code": "state",
     "action": "on"
    }
   }
  },
  "bathroom_radar": {
   "presence": {
    "true": {
     "target": "Bathroom light",
     "code": "state",
     "action": "on"
    },
    "false": {
     "target": "Bathroom light",
     "code": "state",
     "action": "off"
    }
   }
  },
  "presence": {
   "event": {
    "arrival": {
     "target": "Hallway light",
     "code": "state",
     "action": "on",
     "for": 180,
     "retrigger": "restart"
    },
    "departure": {
     "target": "Living room wall switch",
     "code": "state_l1",
     "action": "off"
    }
   }
  }
 },
