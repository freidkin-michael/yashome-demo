# The demo host's demo.env (next to the exported app/, mode 600): the keys setup/compose.demo.yml needs.
# The addresses below are documentation examples: put the demo host's own there.
DEMO_PASSWORD=
# the end-of-session summary links it (empty: no link)
DEMO_FEEDBACK_URL=
# the public name of the demo (the front proxy's Host): the backend accepts browser requests from it
DEMO_HOST=demo.example.org
# the demo host's address and port the front proxy reaches; the firewall opens it to DEMO_PROXY_IP alone
DEMO_BIND=192.0.2.5
DEMO_PORT=8780
DEMO_PROXY_IP=192.0.2.6
# the internal network of the demo and the edge proxy's fixed address in it (pick an unused private range)
DEMO_INT_SUBNET=198.51.100.0/24
DEMO_EDGE_IP=198.51.100.10
# where the lease is kept across resets: a directory of uid 1000
DEMO_STATE_HOST=/srv/yashome-demo/state
# the broker's one account (the backend and the simulator); export.sh writes its password file
MQTT_USER=demo
MQTT_PASSWORD=
TZ=UTC
